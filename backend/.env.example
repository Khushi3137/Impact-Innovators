PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Required for database-backed login/register/profile routes
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/student-assistant

# Required for signed JWT auth. Generate a strong value before production.
JWT_SECRET=replace-with-a-strong-secret

# Optional integrations
GOOGLE_CLIENT_ID=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5001/api/calendar/callback
GEMINI_API_KEY=

# Optional email verification/reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
